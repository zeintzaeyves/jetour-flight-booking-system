MONGODB_URI=
# Admin login. ADMIN_SESSION_SECRET must be >= 32 random characters.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional: public DNS for mongodb+srv lookups when your network blocks SRV (e.g. 8.8.8.8,1.1.1.1)
MONGODB_DNS_SERVERS=

# --- AI features (optional: without these the AI assistant is simply unavailable) ---
# Server-side only. Never prefix with NEXT_PUBLIC_.
AI_API_KEY=
# Model id to call (required, no default is hardcoded).
AI_MODEL=
# Hard stop: maximum estimated spend per UTC day, in USD. Unset or 0 disables AI (fails closed).
AI_DAILY_BUDGET=
# "anthropic" (default) or "openai" for any OpenAI-compatible provider (Groq, Gemini, OpenRouter: free tiers exist).
AI_PROVIDER=
# Provider endpoint. Defaults to the Anthropic API; REQUIRED when AI_PROVIDER=openai.
AI_BASE_URL=
# Optional: USD per million tokens, used to estimate spend. Set these to your model's real prices.
AI_PRICE_IN_PER_MTOK=
AI_PRICE_OUT_PER_MTOK=
# Where "talk to a human" points. Without it the assistant says human support is not set up.
SUPPORT_EMAIL=
